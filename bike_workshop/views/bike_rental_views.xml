<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ==================== RENTAL LIST VIEW ==================== -->

        <record id="view_bike_rental_list" model="ir.ui.view">
            <field name="name">bike.rental.list</field>
            <field name="model">bike.rental</field>
            <field name="arch" type="xml">
                <list
                    string="Rentals"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirmed'"
                    decoration-muted="state == 'returned'"
                >
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="bike_id"/>
                    <field name="start_date"/>
                    <field name="expected_return_date"/>
                    <field name="actual_return_date"/>
                    <field name="daily_rental_price"/>
                    <field name="duration_days"/>
                    <field name="total_amount"/>
                    <field
                        name="state"
                        widget="badge"
                        decoration-info="state == 'draft'"
                        decoration-success="state == 'confirmed'"
                        decoration-muted="state == 'returned'"
                    />
                </list>
            </field>
        </record>

        <!-- ==================== RENTAL SEARCH VIEW ==================== -->

<record id="view_bike_rental_search" model="ir.ui.view">
    <field name="name">bike.rental.search</field>
    <field name="model">bike.rental</field>
    <field name="arch" type="xml">
        <search string="Search Rentals">

            <field name="name"/>
            <field name="customer_id"/>
            <field name="bike_id"/>

            <separator/>

            <filter
                name="filter_draft"
                string="Draft"
                domain="[('state', '=', 'draft')]"
            />

            <filter
                name="filter_confirmed"
                string="Confirmed"
                domain="[('state', '=', 'confirmed')]"
            />

            <filter
                name="filter_returned"
                string="Returned"
                domain="[('state', '=', 'returned')]"
            />

        </search>
    </field>
</record>

        <!-- ==================== RENTAL FORM VIEW ==================== -->

        <record id="view_bike_rental_form" model="ir.ui.view">
            <field name="name">bike.rental.form</field>
            <field name="model">bike.rental</field>
            <field name="arch" type="xml">
                <form string="Rental">

                    <header>
                        <button
                            name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                        />

                        <button
                            name="action_return"
                            string="Return Bike"
                            type="object"
                            class="btn-success"
                            invisible="state != 'confirmed'"
                        />

                        <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,confirmed,returned"
                        />
                    </header>

                    <sheet>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>

                            <group>
                                <field
                                    name="customer_id"
                                    options="{'no_create': True}"
                                />

                                <field
                                    name="bike_id"
                                    options="{'no_create': True}"
                                />

                                <field name="daily_rental_price"/>
                            </group>

                            <group>
                                <field name="start_date"/>
                                <field name="expected_return_date"/>
                                <field name="actual_return_date"/>
                                <field name="duration_days"/>
                                <field name="total_amount"/>
                            </group>

                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- ==================== RENTAL ACTIONS ==================== -->

    <record id="action_bike_rental" model="ir.actions.act_window">
            <field name="name">All Rentals</field>
            <field name="res_model">bike.rental</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_bike_rental_search"/>
    </record>

    <record id="action_bike_rental_confirmed" model="ir.actions.act_window">
            <field name="name">Confirmed Rentals</field>
            <field name="res_model">bike.rental</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_bike_rental_search"/>
            <field name="domain">[('state', '=', 'confirmed')]</field>
    </record>

        <!-- ==================== RENTAL MENUS ==================== -->

        <menuitem
            id="menu_bike_rental_root"
            name="Rentals"
            parent="menu_bike_workshop_root"
            sequence="20"
        />

        <menuitem
            id="menu_bike_rental_all"
            name="All Rentals"
            parent="menu_bike_rental_root"
            action="action_bike_rental"
            sequence="10"
        />

        <menuitem
            id="menu_bike_rental_confirmed"
            name="Confirmed Rentals"
            parent="menu_bike_rental_root"
            action="action_bike_rental_confirmed"
            sequence="20"
        />

    </data>
</odoo>
