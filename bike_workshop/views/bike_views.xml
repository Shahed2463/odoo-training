<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_bike_workshop_list_v2" model="ir.ui.view">
        <field name="name">bike.workshop.list.v2</field>
        <field name="model">bike.workshop</field>
        <field name="arch" type="xml">
            <list string="Bikes">
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>
                <field name="daily_rental_price"/>
                <field name="wheel_size"/>
                <field name="purchase_date"/>
                <field name="last_maintenance_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bike_workshop_form_v2" model="ir.ui.view">
        <field name="name">bike.workshop.form.v2</field>
        <field name="model">bike.workshop</field>
        <field name="arch" type="xml">
            <form string="Bike">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="bike_type"/>
                            <field name="wheel_size"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="last_maintenance_date"/>
                            <field name="daily_rental_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bike_workshop" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.workshop</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_bike_workshop_root"
              name="Rami's Bike Workshop"
              web_icon="bike_workshop,static/description/icon.png"
              groups="bike_workshop.group_bike_workshop_staff"
              sequence="10"/>
              
    <menuitem id="menu_bike_workshop_bike" 
              name="Bikes" 
              parent="menu_bike_workshop_root" 
              action="action_bike_workshop" 
              sequence="10"/>

</odoo>