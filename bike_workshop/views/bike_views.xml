<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_bike_workshop_bike_form" model="ir.ui.view">
        <field name="name">bike.workshop.bike.form</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <form string="Bike">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="bike_type"/>
                            <field name="wheel_size"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="last_maintenance_date"/>
                            <field name="daily_rental_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_bike_workshop_bike_tree" model="ir.ui.view">
        <field name="name">bike.workshop.bike.tree</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <list string="Bikes">
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>
                <field name="daily_rental_price"/>
                <field name="last_maintenance_date"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bike_workshop_bike" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.workshop.bike</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_bike_workshop_root" name="Bike Workshop" sequence="10"/>
    <menuitem id="menu_bike_workshop_bikes" name="Bikes" parent="menu_bike_workshop_root" action="action_bike_workshop_bike" sequence="10"/>

</odoo>