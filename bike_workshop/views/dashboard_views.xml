<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Form View -->
    <record id="view_bike_workshop_dashboard_form" model="ir.ui.view">
        <field name="name">bike.workshop.dashboard.form</field>
        <field name="model">bike.workshop.dashboard</field>
        <field name="arch" type="xml">

            <form string="Workshop Operations Dashboard">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            Workshop Operations Dashboard
                        </h1>
                    </div>

                    <div class="row">

                        <!-- Active Rentals Today -->
                        <div class="col-lg-4 col-md-4 col-sm-12">
                            <div class="card mb-4">
                                <div class="card-body text-center">

                                    <h3>
                                        Active Rentals Today
                                    </h3>

                                    <div style="
                                        font-size: 40px;
                                        font-weight: bold;
                                        margin: 15px;
                                    ">
                                        <field
                                            name="active_rentals_today"
                                            nolabel="1"
                                        />
                                    </div>

                                    <button
                                        name="action_open_active_rentals"
                                        type="object"
                                        string="View Rentals"
                                        class="btn btn-primary"
                                    />

                                </div>
                            </div>
                        </div>

                        <!-- Returns Due Today -->
                        <div class="col-lg-4 col-md-4 col-sm-12">
                            <div class="card mb-4">
                                <div class="card-body text-center">

                                    <h3>
                                        Returns Due Today
                                    </h3>

                                    <div style="
                                        font-size: 40px;
                                        font-weight: bold;
                                        margin: 15px;
                                    ">
                                        <field
                                            name="returns_due_today"
                                            nolabel="1"
                                        />
                                    </div>

                                    <button
                                        name="action_open_returns_due_today"
                                        type="object"
                                        string="View Returns"
                                        class="btn btn-primary"
                                    />

                                </div>
                            </div>
                        </div>

                        <!-- Repairs In Progress -->
                        <div class="col-lg-4 col-md-4 col-sm-12">
                            <div class="card mb-4">
                                <div class="card-body text-center">

                                    <h3>
                                        Repairs In Progress
                                    </h3>

                                    <div style="
                                        font-size: 40px;
                                        font-weight: bold;
                                        margin: 15px;
                                    ">
                                        <field
                                            name="repairs_in_progress"
                                            nolabel="1"
                                        />
                                    </div>

                                    <button
                                        name="action_open_repairs_in_progress"
                                        type="object"
                                        string="View Repairs"
                                        class="btn btn-primary"
                                    />

                                </div>
                            </div>
                        </div>

                    </div>

                </sheet>
            </form>

        </field>
    </record>


    <!-- Dashboard Window Action -->
    <record id="action_bike_workshop_dashboard" model="ir.actions.act_window">
        <field name="name">Operations Dashboard</field>
        <field name="res_model">bike.workshop.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bike_workshop_dashboard_form"/>
        <field name="res_id" ref="bike_workshop.dashboard_main"/>
    </record>


    <!-- Dashboard Menu -->
    <menuitem
        id="menu_bike_workshop_dashboard"
        name="Operations Dashboard"
        parent="menu_bike_workshop_root"
        action="action_bike_workshop_dashboard"
        sequence="5"
    />

</odoo>