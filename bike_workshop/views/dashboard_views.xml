<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Form View -->
    <record id="view_bike_workshop_dashboard_form" model="ir.ui.view">
        <field name="name">bike.workshop.dashboard.form</field>
        <field name="model">bike.workshop.dashboard</field>
        <field name="arch" type="xml">

            <form string="" create="0" edit="0" delete="0">
                <sheet>

                    <!-- Dashboard -->
                    <div class="bike-dashboard">

                        <!-- Workshop Branding -->
                        <div class="bike-dashboard-brand">
                            <img
                                src="/bike_workshop/static/src/img/rami_bike_workshop_logo.png"
                                alt="Rami's Bike Workshop"
                                class="bike-workshop-logo"
                            />

                            <div>
                                <h1 t-translation="on">Workshop Operations Dashboard</h1>
                                <p>Rami's Bike Workshop</p>
                            </div>
                        </div>

                        <div class="row">

                            <!-- Active Rentals Today -->
                            <div class="col-lg-4 col-md-4 col-sm-12">
                                <div class="bike-stat-card mb-4">

                                    <div class="bike-stat-icon">
                                        🚲
                                    </div>

                                    <div class="bike-stat-label">
                                        <span t-translation="on">Active Rentals Today</span>
                                    </div>

                                    <div class="bike-stat-value">
                                        <field
                                            name="active_rentals_today"
                                            nolabel="1"
                                        />
                                    </div>

                                    <button
                                        name="action_open_active_rentals"
                                        type="object"
                                        string="View Rentals"
                                        class="btn bike-dashboard-btn"
                                    />

                                </div>
                            </div>

                            <!-- Returns Due Today -->
                            <div class="col-lg-4 col-md-4 col-sm-12">
                                <div class="bike-stat-card mb-4">

                                    <div class="bike-stat-icon">
                                        📅
                                    </div>

                                    <div class="bike-stat-label">
                                        Returns Due Today
                                    </div>

                                    <div class="bike-stat-value">
                                        <field
                                            name="returns_due_today"
                                            nolabel="1"
                                        />
                                    </div>

                                    <button
                                        name="action_open_returns_due_today"
                                        type="object"
                                        string="View Returns"
                                        class="btn bike-dashboard-btn"
                                    />

                                </div>
                            </div>

                            <!-- Repairs In Progress -->
                            <div class="col-lg-4 col-md-4 col-sm-12">
                                <div class="bike-stat-card mb-4">

                                    <div class="bike-stat-icon">
                                        🔧
                                    </div>

                                    <div class="bike-stat-label">
                                        Repairs In Progress
                                    </div>

                                    <div class="bike-stat-value">
                                        <field
                                            name="repairs_in_progress"
                                            nolabel="1"
                                        />
                                    </div>

                                    <button
                                        name="action_open_repairs_in_progress"
                                        type="object"
                                        string="View Repairs"
                                        class="btn bike-dashboard-btn"
                                    />

                                </div>
                            </div>

                        </div>

                    </div>

                </sheet>
            </form>

        </field>
    </record>


    <!-- Dashboard Window Action -->
    <record id="action_bike_workshop_dashboard" model="ir.actions.act_window">
        <field name="name">Operations Dashboard</field>
        <field name="res_model">bike.workshop.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bike_workshop_dashboard_form"/>
        <field name="res_id" ref="bike_workshop.dashboard_main"/>
    </record>


    <!-- Dashboard Menu -->
    <menuitem
        id="menu_bike_workshop_dashboard"
        name="Operations Dashboard"
        parent="menu_bike_workshop_root"
        action="action_bike_workshop_dashboard"
        sequence="5"
    />

    <!-- ==================== DASHBOARD READ-ONLY LIST VIEWS ==================== -->

    <record id="view_bike_rental_dashboard_list" model="ir.ui.view">
        <field name="name">bike.rental.dashboard.list</field>
        <field name="model">bike.rental</field>
        <field name="arch" type="xml">
            <list string="Dashboard Rentals"
                  create="0"
                  edit="0"
                  delete="0">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="start_date"/>
                <field name="expected_return_date"/>
                <field name="actual_return_date"/>
                <field name="duration_days"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bike_repair_dashboard_list" model="ir.ui.view">
        <field name="name">bike.repair.dashboard.list</field>
        <field name="model">bike.repair</field>
        <field name="arch" type="xml">
            <list string="Dashboard Repairs"
                  create="0"
                  edit="0"
                  delete="0">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_source"/>
                <field name="workshop_bike_id"/>
                <field name="external_bike_reference"/>
                <field name="assigned_mechanic"/>
                <field name="total_parts_cost"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>


</odoo>