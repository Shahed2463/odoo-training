<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ==================== RENTAL ANALYSIS PIVOT ==================== -->

        <record id="view_bike_rental_pivot" model="ir.ui.view">
            <field name="name">bike.rental.pivot</field>
            <field name="model">bike.rental</field>
            <field name="arch" type="xml">
                <pivot string="Rental Analysis">

                    <field name="start_date" interval="month" type="row"/>
                    <field name="bike_type" type="row"/>
                    <field name="state" type="row"/>
                    <field name="customer_id" type="row"/>
                    <field name="return_performance" type="row"/>

                    <field name="total_amount" type="measure"/>
                    <field name="duration_days" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ==================== RENTAL ANALYSIS GRAPH ==================== -->

        <record id="view_bike_rental_graph" model="ir.ui.view">
            <field name="name">bike.rental.graph</field>
            <field name="model">bike.rental</field>
            <field name="arch" type="xml">
                <graph string="Rental Analysis" type="bar">

                    <field name="start_date" interval="month"/>
                    <field name="total_amount" type="measure"/>

                </graph>
            </field>
        </record>

        <!-- ==================== RENTAL ANALYSIS SEARCH ==================== -->

        <record id="view_bike_rental_analysis_search" model="ir.ui.view">
            <field name="name">bike.rental.analysis.search</field>
            <field name="model">bike.rental</field>
            <field name="arch" type="xml">
                <search string="Rental Analysis">

                    <field name="customer_id"/>
                    <field name="bike_id"/>
                    <field name="bike_type"/>
                    <field name="start_date"/>
                    <field name="state"/>
                    <field name="return_performance"/>

                    <separator/>

                    <filter
                        name="filter_confirmed"
                        string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"
                    />

                    <filter
                        name="filter_returned"
                        string="Returned"
                        domain="[('state', '=', 'returned')]"
                    />

                    <filter
                        name="filter_on_time"
                        string="On Time"
                        domain="[('return_performance', '=', 'on_time')]"
                    />

                    <filter
                        name="filter_late"
                        string="Late"
                        domain="[('return_performance', '=', 'late')]"
                    />

                    <filter
                        name="filter_pending"
                        string="Pending"
                        domain="[('return_performance', '=', 'pending')]"
                    />

                    <separator/>

                    <group>

                        <filter
                            name="group_rental_month"
                            string="Rental Month"
                            context="{'group_by': 'start_date:month'}"
                        />

                        <filter
                            name="group_bike_type"
                            string="Bike Type"
                            context="{'group_by': 'bike_type'}"
                        />

                        <filter
                            name="group_status"
                            string="Rental Status"
                            context="{'group_by': 'state'}"
                        />

                        <filter
                            name="group_customer"
                            string="Customer"
                            context="{'group_by': 'customer_id'}"
                        />

                        <filter
                            name="group_return_performance"
                            string="Return Performance"
                            context="{'group_by': 'return_performance'}"
                        />

                    </group>

                </search>
            </field>
        </record>

        <!-- ==================== RENTAL ANALYSIS ACTION ==================== -->

        <record id="action_bike_rental_analysis" model="ir.actions.act_window">
            <field name="name">Rental Analysis</field>
            <field name="res_model">bike.rental</field>
            <field name="view_mode">pivot,graph</field>
            <field name="search_view_id" ref="view_bike_rental_analysis_search"/>
            <field name="domain">[('state', '!=', 'draft')]</field>
        </record>

        <!-- ==================== RENTAL ANALYSIS MENU ==================== -->

        <menuitem
            id="menu_bike_rental_analysis"
            name="Rental Analysis"
            parent="menu_bike_rental_root"
            action="action_bike_rental_analysis"
            sequence="30"
        />

    </data>
</odoo>
