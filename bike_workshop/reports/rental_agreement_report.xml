<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Rental Agreement Report -->
    <record id="action_report_rental_agreement" model="ir.actions.report">
        <field name="name">Rental Agreement</field>
        <field name="model">bike.rental</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bike_workshop.rental_agreement_template</field>
        <field name="report_file">bike_workshop.rental_agreement_template</field>
        <field name="binding_model_id" ref="model_bike_rental"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Rental Agreement - %s' % (object.name)</field>
    </record>

    <!-- Rental Agreement Template -->
    <template id="rental_agreement_template">
        <meta charset="UTF-8"/>

        <t t-call="web.html_container" t-translation="off">

            <t t-foreach="docs" t-as="o">

                <div class="page" style="font-family: 'Noto Sans Arabic', 'Noto Sans', sans-serif;">

                    <!-- Workshop Company Information -->
                    <div style="
                        text-align: center;
                        margin-top: -15px;
                        margin-bottom: 12px;
                        padding-bottom: 10px;
                        border-bottom: 2px solid #1F4E79;
                    ">

                        <!-- Company Logo -->
                        <t t-if="env.company.logo">
                            <img
                                t-att-src="image_data_uri(env.company.logo)"
                                style="
                                    max-height: 65px;
                                    max-width: 160px;
                                    margin-bottom: 3px;
                                "
                            />
                        </t>

                        <!-- Company Name -->
                        <h2 style="
                            color: #1F4E79;
                            margin: 2px 0;
                            font-size: 22px;
                            font-weight: 700;
                        ">
                            <span t-out="env.company.name"/>
                        </h2>

                        <!-- Company Contact Information -->
                        <div style="
                            color: #666666;
                            font-size: 11px;
                        ">

                            <t t-if="env.company.phone">
                                <span t-out="env.company.phone"/>
                            </t>

                            <t t-if="env.company.email">
                                <span t-if="env.company.phone"> | </span>
                                <span t-out="env.company.email"/>
                            </t>

                            <t t-if="env.company.website">
                                <span> | </span>
                                <span t-out="env.company.website"/>
                            </t>

                        </div>

                    </div>

                    <!-- Main Header -->
                    <div style="
                        text-align: center;
                        padding: 12px 0 10px 0;
                        border-bottom: 3px solid #1F4E79;
                        margin-bottom: 20px;
                    ">

                        <h1 style="
                            color: #1F4E79;
                            font-size: 28px;
                            margin: 0;
                            font-weight: 700;
                        ">
                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                ورشة الدراجات
                            </t>
                            <t t-else="">
                                BIKE WORKSHOP
                            </t>
                        </h1>

                        <h2 style="
                            color: #555555;
                            font-size: 20px;
                            margin: 4px 0 0 0;
                            font-weight: 500;
                        ">
                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                اتفاقية الإيجار
                            </t>
                            <t t-else="">
                                Rental Agreement
                            </t>
                        </h2>

                    </div>

                    <!-- Rental Reference / Status -->
                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 20px;
                    ">
                        <tr>

                            <td style="
                                width: 50%;
                                padding: 11px;
                                background-color: #EEF5FB;
                                border-left: 4px solid #1F4E79;
                            ">

                                <span style="
                                    color: #666666;
                                    font-size: 11px;
                                ">
                                    <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                        مرجع الإيجار
                                    </t>
                                    <t t-else="">
                                        RENTAL REFERENCE
                                    </t>
                                </span>

                                <br/>

                                <strong style="
                                    color: #1F4E79;
                                    font-size: 16px;
                                ">
                                    <span t-field="o.name"/>
                                </strong>

                            </td>

                            <td style="
                                width: 50%;
                                padding: 11px;
                                text-align: right;
                                background-color: #EEF5FB;
                            ">

                                <span style="
                                    color: #666666;
                                    font-size: 11px;
                                ">
                                    <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                        الحالة
                                    </t>
                                    <t t-else="">
                                        STATUS
                                    </t>
                                </span>

                                <br/>

                                <strong style="
                                    color: #1F4E79;
                                    font-size: 14px;
                                ">

                                    <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">

                                        <t t-if="o.state == 'draft'">
                                            مسودة
                                        </t>

                                        <t t-elif="o.state == 'confirmed'">
                                            مؤكد
                                        </t>

                                        <t t-elif="o.state == 'returned'">
                                            مُعاد
                                        </t>

                                        <t t-else="">
                                            <span t-out="o.state"/>
                                        </t>

                                    </t>

                                    <t t-else="">

                                        <t t-if="o.state == 'draft'">
                                            Draft
                                        </t>

                                        <t t-elif="o.state == 'confirmed'">
                                            Confirmed
                                        </t>

                                        <t t-elif="o.state == 'returned'">
                                            Returned
                                        </t>

                                        <t t-else="">
                                            <span t-out="o.state"/>
                                        </t>

                                    </t>

                                </strong>

                            </td>

                        </tr>
                    </table>

                    <!-- Customer Information -->
                    <div style="margin-top: 18px;">

                        <div style="
                            background-color: #1F4E79;
                            color: white;
                            padding: 8px 12px;
                            font-size: 14px;
                            font-weight: 600;
                        ">
                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                معلومات العميل
                            </t>
                            <t t-else="">
                                Customer Information
                            </t>
                        </div>

                        <table style="
                            width: 100%;
                            border-collapse: collapse;
                            border: 1px solid #D9E2F3;
                        ">

                            <tbody>

                                <tr>

                                    <td style="
                                        width: 30%;
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                العميل
                                            </t>
                                            <t t-else="">
                                                Customer
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <span t-field="o.customer_id.name"/>
                                    </td>

                                </tr>

                                <t t-if="o.customer_id.email">

                                    <tr>

                                        <td style="
                                            padding: 8px 12px;
                                            background-color: #F5F8FC;
                                            border-bottom: 1px solid #D9E2F3;
                                        ">
                                            <strong>
                                                <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                    البريد الإلكتروني
                                                </t>
                                                <t t-else="">
                                                    Email
                                                </t>
                                            </strong>
                                        </td>

                                        <td style="
                                            padding: 8px 12px;
                                            border-bottom: 1px solid #D9E2F3;
                                        ">
                                            <span t-field="o.customer_id.email"/>
                                        </td>

                                    </tr>

                                </t>

                                <t t-if="o.customer_id.phone">

                                    <tr>

                                        <td style="
                                            padding: 8px 12px;
                                            background-color: #F5F8FC;
                                        ">
                                            <strong>
                                                <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                    الهاتف
                                                </t>
                                                <t t-else="">
                                                    Phone
                                                </t>
                                            </strong>
                                        </td>

                                        <td style="
                                            padding: 8px 12px;
                                        ">
                                            <span t-field="o.customer_id.phone"/>
                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                    </div>

                    <!-- Rental Information -->
                    <div style="margin-top: 22px;">

                        <div style="
                            background-color: #1F4E79;
                            color: white;
                            padding: 8px 12px;
                            font-size: 14px;
                            font-weight: 600;
                        ">
                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                معلومات الإيجار
                            </t>
                            <t t-else="">
                                Rental Information
                            </t>
                        </div>

                        <table style="
                            width: 100%;
                            border-collapse: collapse;
                            border: 1px solid #D9E2F3;
                        ">

                            <tbody>

                                <tr>

                                    <td style="
                                        width: 40%;
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                الدراجة
                                            </t>
                                            <t t-else="">
                                                Bike
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <span t-field="o.bike_id"/>
                                    </td>

                                </tr>

                                <tr>

                                    <td style="
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                تاريخ بدء الإيجار
                                            </t>
                                            <t t-else="">
                                                Rental Start Date
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <span t-field="o.start_date"/>
                                    </td>

                                </tr>

                                <tr>

                                    <td style="
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                تاريخ الإرجاع المتوقع
                                            </t>
                                            <t t-else="">
                                                Expected Return Date
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <span t-field="o.expected_return_date"/>
                                    </td>

                                </tr>

                                <tr>

                                    <td style="
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                تاريخ الإرجاع الفعلي
                                            </t>
                                            <t t-else="">
                                                Actual Return Date
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                    ">

                                        <t t-if="o.actual_return_date">

                                            <span t-field="o.actual_return_date"/>

                                        </t>

                                        <t t-else="">

                                            <span style="color: #888888;">
                                                <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                    غير متوفر
                                                </t>
                                                <t t-else="">
                                                    N/A
                                                </t>
                                            </span>

                                        </t>

                                    </td>

                                </tr>

                                <tr>

                                    <td style="
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                مدة الإيجار
                                            </t>
                                            <t t-else="">
                                                Rental Duration
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                    ">
                                        <span t-field="o.duration_days"/>
                                        <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                            أيام
                                        </t>
                                        <t t-else="">
                                            Days
                                        </t>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                    <!-- Payment Information -->
                    <div style="margin-top: 22px;">

                        <div style="
                            background-color: #1F4E79;
                            color: white;
                            padding: 8px 12px;
                            font-size: 14px;
                            font-weight: 600;
                        ">
                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                معلومات الدفع
                            </t>
                            <t t-else="">
                                Payment Information
                            </t>
                        </div>

                        <table style="
                            width: 100%;
                            border-collapse: collapse;
                            border: 1px solid #D9E2F3;
                        ">

                            <tbody>

                                <tr>

                                    <td style="
                                        width: 70%;
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                سعر الإيجار اليومي
                                            </t>
                                            <t t-else="">
                                                Daily Rental Price
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                        text-align: right;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <span t-field="o.daily_rental_price"/>
                                    </td>

                                </tr>

                                <tr>

                                    <td style="
                                        padding: 8px 12px;
                                        background-color: #F5F8FC;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                مدة الإيجار
                                            </t>
                                            <t t-else="">
                                                Rental Duration
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 8px 12px;
                                        text-align: right;
                                        border-bottom: 1px solid #D9E2F3;
                                    ">
                                        <span t-field="o.duration_days"/>
                                        <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                            أيام
                                        </t>
                                        <t t-else="">
                                            Days
                                        </t>
                                    </td>

                                </tr>

                                <!-- Total -->
                                <tr>

                                    <td style="
                                        padding: 12px;
                                        background-color: #DCEAF7;
                                        color: #1F4E79;
                                        font-size: 15px;
                                    ">
                                        <strong>
                                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                                المبلغ الإجمالي
                                            </t>
                                            <t t-else="">
                                                Total Amount
                                            </t>
                                        </strong>
                                    </td>

                                    <td style="
                                        padding: 12px;
                                        text-align: right;
                                        background-color: #DCEAF7;
                                        color: #1F4E79;
                                        font-size: 17px;
                                    ">
                                        <strong>
                                            <span t-field="o.total_amount"/>
                                        </strong>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                    <!-- Footer Message -->
                    <div style="
                        margin-top: 28px;
                        padding: 12px;
                        text-align: center;
                        border-top: 1px solid #D9E2F3;
                    ">

                        <p style="
                            margin: 0;
                            color: #555555;
                        ">
                            <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                شكرًا لاختياركم
                            </t>
                            <t t-else="">
                                Thank you for choosing
                            </t>

                            <strong style="color: #1F4E79;">
                                <t t-if="o.customer_id.lang and o.customer_id.lang.startswith('ar')">
                                    ورشة الدراجات
                                </t>
                                <t t-else="">
                                    Bike Workshop
                                </t>
                            </strong>.
                        </p>

                    </div>

                </div>

            </t>

        </t>

    </template>

</odoo>
